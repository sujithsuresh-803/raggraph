# Copy to .env and adjust. Every value has a sane default — the service
# runs fully offline with none of these set.

# Vector store: ":memory:" (in-process Qdrant) or a server URL like http://qdrant:6333
QDRANT_LOCATION=:memory:
QDRANT_COLLECTION=raggraph

# Retrieval knobs
TOP_K=4                 # final passages handed to the LLM
CANDIDATE_K=20          # candidates pulled per retriever before fusion/rerank
RRF_K=60                # reciprocal-rank-fusion constant
MAX_RETRIES=1           # re-query loop attempts when retrieval grades "weak"

# LLM generation. Leave ANTHROPIC_API_KEY unset to use the extractive stub.
LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...

LOG_LEVEL=INFO
